{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "typeRoots": [
            "./node_modules/@types",
            "./types"
        ],
        "lib": [
            "dom",
            "dom.iterable",
            "esnext"
        ],
        "jsx": "preserve",
        "plugins": [
            {
                "name": "next"
            }
        ],
    },
    "include": [
        "next-env.d.ts",
        ".next/types/**/*.ts",
        "**/*.ts",
        "**/*.tsx"
    ],
    "exclude": [
        "node_modules"
    ]
}