{
    "name": "stephenmatheis.com",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "build-static": "next build && next export",
        "start": "next start",
        "lint": "next lint",
        "clean": "rm -rf .next",
        "crawl": "NODE_OPTIONS=\"--no-warnings\" node ./main.js",
        "docker:build": "docker build -t bookmarks .",
        "docker:run": "docker run -v $(pwd)/public/screenshots:/app/public/screenshots -v $(pwd)/logs:/app/logs bookmarks",
        "docker:all": "npm run docker:build && npm run docker:run"
    },
    "dependencies": {
        "@playwright/browser-chromium": "^1.49.0",
        "classnames": "^2.5.1",
        "csv-parser": "^3.0.0",
        "eslint": "^8.57.1",
        "next": "^14.2.18",
        "playwright": "^1.49.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "save-dev": "^0.0.1-security"
    },
    "devDependencies": {
        "@playwright/test": "^1.49.0",
        "@types/node": "^20.17.8",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "dotenv-cli": "^7.4.4",
        "eslint-config-next": "^14.2.18",
        "sass": "^1.81.0",
        "tsx": "^3.14.0",
        "typescript": "^5.7.2"
    }
}
